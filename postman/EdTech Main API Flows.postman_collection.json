  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function responseJson() {",
          "  try { return pm.response.json(); } catch (error) { return null; }",
          "}",
          "",
          "function responseData() {",
          "  const json = responseJson();",
          "  if (!json) return {};",
          "  return json.data !== undefined ? json.data : json;",
          "}",
          "",
          "function logFailure(reason) {",
          "  const json = responseJson();",
          "  console.log('[MAIN FLOW FAIL]', {",
          "    step: pm.info.requestName,",
          "    reason,",
          "    method: pm.request.method,",
          "    url: pm.request.url.toString(),",
          "    status: pm.response.code,",
          "    requestBody: pm.request.body ? pm.request.body.toString() : undefined,",
          "    responseBody: pm.response.text(),",
          "    requestId: json && json.meta && json.meta.requestId,",
          "    errorCode: json && json.error && json.error.code,",
          "    errorMessage: json && json.error && json.error.message,",
          "    state: {",
          "      courseId: pm.collectionVariables.get('courseId'),",
          "      classroomId: pm.collectionVariables.get('classroomId'),",
          "      lessonId: pm.collectionVariables.get('lessonId'),",
          "      roadmapId: pm.collectionVariables.get('roadmapId'),",
          "      examId: pm.collectionVariables.get('examId'),",
          "      submissionId: pm.collectionVariables.get('submissionId'),",
          "      sessionId: pm.collectionVariables.get('sessionId'),",
          "      notificationId: pm.collectionVariables.get('notificationId'),",
          "      jobId: pm.collectionVariables.get('jobId')",
          "    }",
          "  });",
          "}",
          "",
          "function assertSuccess(expectedStatuses) {",
          "  const json = responseJson();",
          "  if (!expectedStatuses.includes(pm.response.code)) logFailure('unexpected_status');",
          "  if (json && json.success === false) logFailure('gateway_success_false');",
          "  pm.test('status is expected', () => pm.expect(expectedStatuses).to.include(pm.response.code));",
          "  pm.test('gateway envelope did not fail', () => { if (json) pm.expect(json.success).to.not.eql(false); });",
          "}",
          "",
          "function saveDataVar(varName, key) {",
          "  const data = responseData();",
          "  if (data && data[key]) pm.collectionVariables.set(varName, data[key]);",
          "}"
        ]
      }
    }
