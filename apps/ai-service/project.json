{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "grpc": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -c \"import sys; sys.path.insert(0, 'src'); from agents.grpc.server import serve; serve()\""
      }
    },
    "worker": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -c \"import sys; sys.path.insert(0, 'src'); from agents.workers.main import main; main()\""
      }
    },
    "serve-http": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -c \"import sys; sys.path.insert(0, 'src'); from api.main import serve; serve()\""
      }
    },
    "maintenance": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -c \"import sys; sys.path.insert(0, 'src'); from agents.ops.maintenance import main; main()\""
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -m compileall src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -m unittest discover -s tests"
      }
    },
    "proto:generate": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/contracts/generated"],
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python src/contracts/generate_proto.py"
      }
    }
  }
}
