              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Clerk created teacher session', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('teacherSessionId', data.id);"
