{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run uvicorn --app-dir src main:app --host localhost --port 8090"
      }
    },
    "worker": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -m agents.workers.main"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python -m compileall src"
      }
    },
    "proto:generate": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/contracts/generated"],
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python src/contracts/generate_proto.py"
      }
    }
  }
}
